{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "auth:generate": "varlock run -- bun x auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes",
    "build": "tsc -b ../../packages/api && tsdown",
    "check-types": "tsc -b ../../packages/api && tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "env:generate": "varlock codegen",
    "seed:config": "tsx src/seed/write-config.ts",
    "start": "node dist/index.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@rave/api": "workspace:*",
    "@rave/auth": "workspace:*",
    "@rave/db": "workspace:*",
    "better-auth": "catalog:",
    "fastify": "^5.12.3",
    "pino": "^10.3.1",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@rave/config": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-orm": "catalog:",
    "pino-pretty": "^13.1.3",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "vitest": "^5.0.1"
  }
}
