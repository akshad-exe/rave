# Generated by `bun run setup`, which copies this file to apps/server/.env and
# fills in a random BETTER_AUTH_SECRET. Run that before `docker compose up`.
NODE_ENV=development
LOG_LEVEL=info

# API port. Change it if 3000 is already in use; the seeded logins and
# .dogfood.toml base URL are unaffected.
PORT=3000

# Must be at least 32 characters. Generate one with: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# The host and the compose services must agree on this password. The default
# below matches POSTGRES_PASSWORD in docker-compose.yml; if you change one,
# change both, or a fresh postgres volume will be created with a different
# password than the host expects.
DATABASE_URL=postgresql://postgres:ravepass@localhost:5432/rave
