# Copy to .env and adjust. `docker compose up` does this for you on first run.
NODE_ENV=development
LOG_LEVEL=info

# API port. Change it if 3000 is already in use; the seeded logins and
# .dogfood.toml base URL are unaffected.
PORT=3000

# Must be at least 32 characters. Generate one with: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# Overridden by docker-compose.yml so the container reaches the postgres service.
DATABASE_URL=postgresql://postgres:ravepass@localhost:5432/rave
